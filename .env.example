# Copy to .env and fill in. Variables already set in your shell win over this file.

# --- Anthropic (default) ---
ANTHROPIC_API_KEY=sk-ant-xxx
MODEL_ID=claude-opus-5-5

# --- Any Anthropic-compatible endpoint: set the base URL and a model it serves ---
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_API_KEY=sk-xxx
# MODEL_ID=deepseek-chat

# --- Local Ollama ---
# ANTHROPIC_BASE_URL=http://localhost:11434
# ANTHROPIC_API_KEY=ollama
# MODEL_ID=qwen3-coder

# s06: compact when a request reaches this many tokens
# COMPACT_THRESHOLD=120000
